# speckit-enhanced — Environment Variables
# Copy this file to .env and fill in your API keys

# ── LLM API Keys ──────────────────────────────────────────────────────────────
# Claude (primary) — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (fallback) — get key at https://platform.openai.com
OPENAI_API_KEY=your-openai-api-key-here

# ── Model Selection ───────────────────────────────────────────────────────────
# Override default model choices
CLAUDE_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o
OLLAMA_MODEL=llama3

# ── Ollama (offline/privacy mode) ────────────────────────────────────────────
# URL for local Ollama instance
OLLAMA_BASE_URL=http://localhost:11434

# Set to "true" to force Ollama only (no external API calls)
PRIVACY_MODE=false

# ── GitHub (for knowledge crawler) ───────────────────────────────────────────
# Increases GitHub API rate limit from 60 to 5000 req/hr
# Get token at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your-github-token-here

# ── Agent Settings ────────────────────────────────────────────────────────────
# Data directory for SQLite database
DATA_DIR=./data

# Models cache directory
MODELS_DIR=./models

# Server configuration
HOST=0.0.0.0
PORT=8020

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
